// Failures across the app (BR14, BR15): warning and error log calls, retries scheduled, retries
// used up (the message goes on to the dead-letter queue), failed host executions and exceptions.
// Read-only. Run from the repo root (one plain az command; --offset must cover `since`):
//   az monitor app-insights query --app df1c0c8f-12fe-41b7-a022-e3e5f1989f2e --offset 6h --analytics-query @scripts/sandbox/kql/errors-retries-deadletters.kql -o json --query "tables[0].rows"
// The dead-letter queue count itself is read from Service Bus:
//   az servicebus queue show -g centralreachintegration --namespace-name ucr-hs-cr-sb-prod --name client-sync-queue --query countDetails -o json
//   az servicebus queue show -g centralreachintegration --namespace-name ucr-hs-cr-sb-prod --name employee-sync-queue --query countDetails -o json
//
// How the app logs: safeLog calls console[level](message, meta). Node prints the meta over
// several lines and the Functions host stores EACH LINE as its own `traces` row, Category
// Host.Function.Console, with no operation_Id and no InvocationId. The lines of one call are
// consecutive rows of one worker process, so `calls` below orders by process and time: a key line
// (`name: 'value',`) or the closing `}` continues the call above it, any other line starts a new
// call. One row per log call comes out: `logMessage` (the header) and `text` (all lines).
// Console warn/error may not raise severityLevel, so warn/error calls are also matched by their
// header text (the warn and error messages in src/). "Retries used up" is the text of
// RETRIES_USED_UP (src/constants/syncReasons.mjs); a workflow failure with "lastAttempt":true is
// the last try before it.
let since = 6h; // day-2 checks (retry chain, 08:00 UTC sweep; run sheet S10): 30h, with --offset 30h
let kv = (t: string, k: string) {
    coalesce(extract(strcat(@"\b", k, @": '([^']*)'"), 1, t),
        extract(strcat(@"\b", k, @": ""([^""]*)"""), 1, t))
};
let calls = traces
    | where timestamp > ago(since)
    | where tostring(customDimensions.Category) == "Host.Function.Console"
        or tostring(customDimensions.Category) endswith ".User"
    | extend proc = strcat(cloud_RoleInstance, "/", tostring(customDimensions.ProcessId)),
        line = trim_start(@"\s+", message)
    | extend isPart = line == "}" or line matches regex @"^[A-Za-z_$][\w$]*: ['""`]"
    | order by proc asc, timestamp asc, itemId asc
    | extend callNo = row_cumsum(iff(isPart and proc == prev(proc), 0, 1))
    | summarize callTime = min(timestamp), severityLevel = max(severityLevel),
        header = take_anyif(line, not(isPart)), parts = make_list(line), lineCount = count()
        by proc, callNo
    | extend text = strcat_array(parts, "\n"),
        logMessage = extract(@"(?s)^(.*?)\s*(?:\{.*)?$", 1, header)
    | extend inv = kv(text, "invocationId"),
        record = coalesce(kv(text, "recordId"), kv(text, "dealId"), kv(text, "contactId"))
    | extend record = iff(record matches regex @"^\d+$", record, "");
let usedUp = @"(?i)retries[ _]used[ _]up";
let warnOrErrorHeader = @"(?i)fail|warning|could not|differs|placeholder|missing requested|not for this portal|INTAKE_POLLER_SCHEDULE|^Change found by the poller";
let hostRows = traces
    | where timestamp > ago(since)
    | extend inv = tostring(customDimensions.InvocationId)
    | where isnotempty(inv);
let fnByInv = hostRows
    | summarize fn = take_any(operation_Name), operation_Id = take_any(operation_Id) by inv;
let invByOp = hostRows
    | where isnotempty(operation_Id)
    | summarize opInv = take_any(inv) by operation_Id;
let recordByInv = calls
    | where isnotempty(inv) and isnotempty(record)
    | summarize record = take_any(record) by inv;
union
    (calls
        | extend signal = case(
            text matches regex usedUp or text contains '"lastAttempt":true', "dead-letter",
            logMessage == "Sync failed. A retry is scheduled.", "retry",
            logMessage == "Sync run summary." and kv(text, "outcome") == "error", "run-error",
            severityLevel >= 2 or logMessage matches regex warnOrErrorHeader, "warn/error",
            "")
        | where isnotempty(signal)
        | join kind=leftouter fnByInv on inv
        | project timestamp = callTime, signal, severityLevel, fn, record,
            nextAttempt = kv(text, "nextAttempt"), delaySeconds = kv(text, "delaySeconds"),
            reasonCode = kv(text, "reasonCode"), line = logMessage, detail = text, inv, operation_Id),
    (hostRows
        | where severityLevel >= 2
        | where tostring(customDimensions.Category) != "Host.Function.Console"
        | join kind=leftouter recordByInv on inv
        | project timestamp, signal = iff(message matches regex usedUp, "dead-letter", "host warn/error"),
            severityLevel, fn = operation_Name, record, nextAttempt = "", delaySeconds = "",
            reasonCode = "", line = message, detail = "", inv, operation_Id),
    (exceptions
        | where timestamp > ago(since)
        | extend line = coalesce(tostring(column_ifexists("outerMessage", "")),
                tostring(column_ifexists("problemId", "")), tostring(column_ifexists("type", ""))),
            inv = tostring(customDimensions.InvocationId)
        | join kind=leftouter invByOp on operation_Id
        | extend inv = coalesce(inv, opInv)
        | join kind=leftouter recordByInv on inv
        | project timestamp, signal = iff(line matches regex usedUp, "dead-letter", "exception"),
            severityLevel, fn = operation_Name, record, nextAttempt = "", delaySeconds = "",
            reasonCode = "", line, detail = tostring(column_ifexists("problemId", "")), inv,
            operation_Id)
| order by timestamp asc
